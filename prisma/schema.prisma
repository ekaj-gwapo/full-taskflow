// This is your Prisma schema file for Neon Stack Auth
// Stack Auth provides managed authentication

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Stack Auth Tables
model User {
  id                String    @id @db.Uuid
  email             String    @unique
  emailVerified     Boolean   @default(false)
  name              String?
  image             String?
  banned            Boolean   @default(false)
  banReason         String?
  banExpires        DateTime?
  role              String?   @default("user")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  members           Member[]
  verification      Verification[]

  @@schema("neon_auth")
  @@map("user")
}

model Account {
  id                String    @id @db.Uuid
  userId            String    @db.Uuid
  providerId        String
  accountId         String?
  password          String?
  accessToken       String?
  refreshToken      String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  idToken           String?
  scope             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@schema("neon_auth")
  @@map("account")
}

model Session {
  id                String    @id @db.Uuid
  userId            String    @db.Uuid
  token             String
  expiresAt         DateTime
  ipAddress         String?
  userAgent         String?
  activeOrganizationId String?
  impersonatedBy    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("neon_auth")
  @@map("session")
}

model Verification {
  id                String    @id @db.Uuid
  identifier        String
  value             String
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@schema("neon_auth")
  @@map("verification")
}

model Organization {
  id                String    @id @db.Uuid
  name              String
  slug              String?
  logo              String?
  metadata          String?
  createdAt         DateTime  @default(now())

  members           Member[]
  invitations       Invitation[]

  @@schema("neon_auth")
  @@map("organization")
}

model Member {
  id                String    @id @db.Uuid
  userId            String    @db.Uuid
  organizationId    String    @db.Uuid
  role              String
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@schema("neon_auth")
  @@map("member")
}

model Invitation {
  id                String    @id @db.Uuid
  email             String
  organizationId    String    @db.Uuid
  inviterId         String    @db.Uuid
  role              String
  status            String    @default("pending")
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@schema("neon_auth")
  @@map("invitation")
}
